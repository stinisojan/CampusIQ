# Server Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/campusiq

# JWT Authentication
JWT_SECRET=campusiq_super_secret_jwt_key_2026_dev
JWT_EXPIRES_IN=7d

# AI Providers ('gemini' or 'openai')
EMBEDDING_PROVIDER=gemini
LLM_PROVIDER=gemini

# Google Gemini API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# OpenAI API Keys (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Store ('memory' or 'pinecone')
VECTOR_STORE=memory
PINECONE_API_KEY=
PINECONE_INDEX_NAME=campusiq
PINECONE_ENVIRONMENT=

# RAG & Retrieval Tuning
SIMILARITY_THRESHOLD=0.35
TOP_K_RESULTS=4
CHUNK_SIZE=700
CHUNK_OVERLAP=150